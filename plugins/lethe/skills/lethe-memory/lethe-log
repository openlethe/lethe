#!/usr/bin/env bash
# lethe-log — restricted CLI fallback for Lethe memory events
# Usage: lethe-log <record|log|flag|task> <message> [options]
#
# Endpoint policy:
#   - Default: http://localhost:18483 only.
#   - Remote: requires LETHE_ALLOW_REMOTE=1, an https:// endpoint, and an
#     exact host:port entry in LETHE_ALLOWED_REMOTE_ENDPOINTS.
#
# Required: curl, jq
# Session: SESSION_KEY or LETHE_SESSION_ID; no implicit or hard-coded fallback.

set -euo pipefail

die() {
  echo "lethe-log: $*" >&2
  exit 1
}

API="${LETHE_API:-http://localhost:18483}"
ALLOW_REMOTE="${LETHE_ALLOW_REMOTE:-0}"
ALLOWED_REMOTE_ENDPOINTS="${LETHE_ALLOWED_REMOTE_ENDPOINTS:-}"
API_KEY="${LETHE_API_KEY:-}"
SESSION_ID="${SESSION_KEY:-${LETHE_SESSION_ID:-}}"

case "$API" in
  http://localhost:18483|http://127.0.0.1:18483)
    ;;
  https://*)
    [[ "$ALLOW_REMOTE" == "1" ]] || die "remote storage requires LETHE_ALLOW_REMOTE=1"
    REMOTE_HOSTPORT="${API#https://}"
    [[ "$REMOTE_HOSTPORT" != */* && "$REMOTE_HOSTPORT" != *\?* && "$REMOTE_HOSTPORT" != *#* ]] ||
      die "remote endpoint must contain only an https host and optional port"
    if [[ "$REMOTE_HOSTPORT" == *:* ]]; then
      REMOTE_HOST="${REMOTE_HOSTPORT%%:*}"
      REMOTE_PORT="${REMOTE_HOSTPORT##*:}"
    else
      REMOTE_HOST="$REMOTE_HOSTPORT"
      REMOTE_PORT="443"
    fi
    [[ "$REMOTE_HOST" =~ ^[A-Za-z0-9.-]+$ ]] || die "remote endpoint host is invalid"
    [[ "$REMOTE_PORT" =~ ^[0-9]+$ && "$REMOTE_PORT" -ge 1 && "$REMOTE_PORT" -le 65535 ]] ||
      die "remote endpoint port is invalid"
    ENDPOINT_LIST=",${ALLOWED_REMOTE_ENDPOINTS//[[:space:]]/},"
    [[ "$ENDPOINT_LIST" == *",${REMOTE_HOST}:${REMOTE_PORT},"* ]] ||
      die "remote endpoint is not in LETHE_ALLOWED_REMOTE_ENDPOINTS"
    ;;
  *)
    die "unsupported endpoint; use loopback http://localhost:18483 or an explicitly approved https endpoint"
    ;;
esac

[[ -n "$SESSION_ID" ]] || die "set SESSION_KEY or LETHE_SESSION_ID; no session fallback is used"
[[ "$SESSION_ID" =~ ^[A-Za-z0-9._-]+$ ]] || die "session identifier contains unsupported characters"

curl_json() {
  local method="$1"
  local url="$2"
  local payload="${3:-}"
  local -a args=(
    --fail
    --silent
    --show-error
    --connect-timeout 5
    --max-time 15
    --proto '=http,https'
    --request "$method"
    "$url"
    --header "Content-Type: application/json"
  )

  if [[ -n "$API_KEY" ]]; then
    args+=(--header "Authorization: Bearer $API_KEY")
  fi
  if [[ "$method" == "POST" || "$method" == "PUT" ]]; then
    args+=(--data "$payload")
  fi

  # No --location: a successful response cannot redirect memory data elsewhere.
  curl "${args[@]}"
}

CMD="${1:-}"
MSG="${2:-}"
[[ -n "$CMD" && -n "$MSG" ]] || die "usage: lethe-log <record|log|flag|task> <message> [options]"
case "$CMD" in
  record|log|flag|task)
    ;;
  *)
    die "unknown command '$CMD'; use record, log, flag, or task"
    ;;
esac

CONFIDENCE="0.8"
TAGS=""
STATUS=""
TASK_ID=""

shift 2
while [[ $# -gt 0 ]]; do
  case "$1" in
    --confidence)
      [[ $# -ge 2 ]] || die "--confidence requires a value"
      CONFIDENCE="$2"
      shift 2
      ;;
    --tags)
      [[ $# -ge 2 ]] || die "--tags requires a value"
      TAGS="$2"
      shift 2
      ;;
    --status)
      [[ $# -ge 2 ]] || die "--status requires a value"
      STATUS="$2"
      shift 2
      ;;
    --task-id)
      [[ $# -ge 2 ]] || die "--task-id requires a value"
      TASK_ID="$2"
      shift 2
      ;;
    *)
      die "unknown option '$1'"
      ;;
  esac
done

if ! jq -e -n --arg value "$CONFIDENCE"   '$value | tonumber | select(. >= 0 and . <= 1)' >/dev/null; then
  die "confidence must be a number from 0.0 to 1.0"
fi

if [[ -n "$TASK_ID" ]]; then
  [[ "$TASK_ID" =~ ^[A-Za-z0-9._-]+$ ]] || die "task identifier contains unsupported characters"
fi

TAGS_JSON="$(jq -cn --arg raw "$TAGS" '
  $raw
  | split(",")
  | map(gsub("^\\s+|\\s+$"; ""))
  | map(select(length > 0))
')"

if [[ "$CMD" == "task" ]]; then
  STATUS="${STATUS:-todo}"
  case "$STATUS" in
    todo|in_progress|done|blocked)
      ;;
    *)
      die "task status must be todo, in_progress, done, or blocked"
      ;;
  esac
fi

if [[ "$CMD" == "task" && -n "$TASK_ID" ]]; then
  PAYLOAD="$(jq -cn --arg status "$STATUS" '{task_status: $status}')"
  RESULT="$(curl_json PUT "$API/api/sessions/$SESSION_ID/events/$TASK_ID" "$PAYLOAD")"
  jq -e . >/dev/null <<<"$RESULT" || die "Lethe returned invalid JSON for task update"
  echo "Task updated: $TASK_ID ($STATUS)"
  exit 0
fi

if [[ "$CMD" == "task" ]]; then
  PAYLOAD="$(jq -cn     --arg session_id "$SESSION_ID"     --arg content "$MSG"     --arg status "$STATUS"     --argjson confidence "$CONFIDENCE"     --argjson tags "$TAGS_JSON"     '{
      session_id: $session_id,
      event_type: "task",
      content: $content,
      confidence: $confidence,
      tags: $tags,
      task_title: $content,
      task_status: $status
    }')"
else
  PAYLOAD="$(jq -cn     --arg session_id "$SESSION_ID"     --arg type "$CMD"     --arg content "$MSG"     --argjson confidence "$CONFIDENCE"     --argjson tags "$TAGS_JSON"     '{
      session_id: $session_id,
      event_type: $type,
      content: $content,
      confidence: $confidence,
      tags: $tags
    }')"
fi

RESULT="$(curl_json POST "$API/api/sessions/$SESSION_ID/events" "$PAYLOAD")"
if ! EVENT_ID="$(jq -er '.event_id // empty' <<<"$RESULT")" || [[ -z "$EVENT_ID" ]]; then
  die "Lethe response did not include an event identifier"
fi

echo "Recorded $CMD event $EVENT_ID"
