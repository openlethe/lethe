{{$cs := .cs}}
<div class="gh">
  <div style="margin-bottom:16px;">
    <a href="/ui/memory/changesets?project={{.project}}" style="font-size:12px;">← changesets</a>
  </div>

  {{/* commit header */}}
  <div class="card" style="overflow:hidden;margin-bottom:20px;">
    <div class="gh-head" style="justify-content:space-between;">
      <span class="gh-mono" style="font-size:12px;color:var(--gh-muted);">commit</span>
      <span class="gh-mono" style="font-size:12px;color:var(--gh-link);">{{index $cs "changeset_id"}}</span>
    </div>
    <div style="padding:16px;">
      <div style="font-size:16px;font-weight:600;margin-bottom:12px;">{{index $cs "message"}}</div>
      <div style="display:grid;grid-template-columns:auto 1fr;gap:5px 16px;font-size:12px;">
        <span class="gh-muted">author</span><span class="gh-mono">{{index $cs "author_principal"}}</span>
        <span class="gh-muted">ref</span><span class="gh-mono">{{index $cs "ref_name"}}</span>
        <span class="gh-muted">parents</span><span class="gh-mono">{{range index $cs "parent_ids"}}<a href="/ui/memory/changesets/{{.}}?project={{$.project}}">{{printf "%.10s" .}}</a> {{end}}</span>
        <span class="gh-muted">created</span><span>{{index $cs "created_at"}}</span>
        <span class="gh-muted">idempotency</span><span class="gh-mono gh-muted">{{index $cs "idempotency_key"}}</span>
        <span class="gh-muted">schema</span><span class="gh-mono gh-muted">{{index $cs "schema_version"}}</span>
      </div>
    </div>
  </div>

  {{/* ops as changed files */}}
  <div class="gh-muted" style="font-size:12px;margin-bottom:10px;">
    <b style="color:var(--gh-text);">{{len (index $cs "ops")}}</b> operation{{if ne (len (index $cs "ops")) 1}}s{{end}}
  </div>

  {{range $op := (index $cs "ops")}}
  {{$t := index $op "op_type"}}
  <div class="card" style="overflow:hidden;margin-bottom:14px;">
    <div class="gh-head">
      <span class="gh-pill" style="font-weight:600;
        {{if eq $t "add_memory"}}color:var(--gh-green);border-color:rgba(26,127,55,.4);background:rgba(26,127,55,.08);
        {{else if eq $t "correct_memory"}}color:var(--gh-amber);border-color:rgba(154,103,0,.4);background:rgba(154,103,0,.08);
        {{else if eq $t "supersede_memory"}}color:var(--gh-red);border-color:rgba(207,34,46,.4);background:rgba(207,34,46,.08);
        {{else if eq $t "add_relationship"}}color:var(--gh-link);border-color:rgba(9,105,218,.4);background:rgba(9,105,218,.08);
        {{else if or (eq $t "attach_evidence") (eq $t "attach_verification")}}color:var(--gh-purple);border-color:rgba(130,80,223,.4);background:rgba(130,80,223,.08);
        {{end}}">{{$t}}</span>
      <span class="gh-mono gh-muted" style="font-size:11px;">op #{{index $op "ordinal"}}</span>
      <span class="gh-mono gh-muted" style="font-size:11px;margin-left:auto;">
        {{with index $op "target_event_id"}}→ {{.}} · {{end}}{{with index $op "resulting_event_id"}}{{.}}{{end}}
      </span>
    </div>
    {{with index $op "payload"}}
    <div style="padding:14px 16px;">
      {{with index . "content"}}<div style="font-size:13px;line-height:1.65;margin-bottom:10px;">{{.}}</div>{{end}}
      <div style="display:flex;gap:6px;flex-wrap:wrap;">
        {{with index . "kind"}}<span class="gh-pill">{{.}}</span>{{end}}
        {{with index . "event_type"}}<span class="gh-pill">{{.}}</span>{{end}}
        {{with index . "scope"}}<span class="gh-pill">{{.}}</span>{{end}}
        {{with index . "tags"}}{{range .}}<span class="gh-pill" style="background:var(--gh-bg);">{{.}}</span>{{end}}{{end}}
      </div>
      <details style="margin-top:10px;"><summary class="gh-muted" style="font-size:11px;cursor:pointer;">raw payload</summary>
        <pre class="gh-mono gh-muted" style="margin-top:8px;font-size:11px;white-space:pre-wrap;background:var(--gh-bg);border:1px solid var(--gh-border);border-radius:6px;padding:10px;">{{prettyJSON .}}</pre>
      </details>
    </div>
    {{end}}
  </div>
  {{end}}
</div>
