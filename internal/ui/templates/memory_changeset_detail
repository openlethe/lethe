{{$cs := .cs}}
<div class="lx">
  <div style="margin-bottom:18px;">
    <a href="/ui/memory/changesets?project={{.project}}" class="mono" style="font-size:11px;letter-spacing:.08em;text-transform:uppercase;">← changesets</a>
  </div>

  <div class="kick">commit</div>
  <h1 style="font-size:26px;letter-spacing:-.02em;margin:8px 0 14px;font-weight:700;max-width:30ch;">{{index $cs "message"}}</h1>
  <div class="rule"></div>
  <div style="display:grid;grid-template-columns:auto 1fr;gap:6px 18px;font-size:12.5px;padding:16px 0;">
    <span class="mut">changeset</span><span class="mono" style="color:var(--deep);">{{index $cs "changeset_id"}}</span>
    <span class="mut">author</span><span class="mono">{{index $cs "author_principal"}}</span>
    <span class="mut">ref</span><span class="mono">{{index $cs "ref_name"}}</span>
    <span class="mut">parents</span><span class="mono">{{range index $cs "parent_ids"}}<a href="/ui/memory/changesets/{{.}}?project={{$.project}}" style="color:var(--deep);">{{printf "%.10s" .}}</a> {{end}}</span>
    <span class="mut">created</span><span>{{index $cs "created_at"}}</span>
    <span class="mut">idempotency</span><span class="mono mut">{{index $cs "idempotency_key"}}</span>
    <span class="mut">schema</span><span class="mono mut">{{index $cs "schema_version"}}</span>
  </div>
  <div class="rule"></div>

  <div class="kick" style="margin:18px 0 10px;">{{len (index $cs "ops")}} operation{{if ne (len (index $cs "ops")) 1}}s{{end}}</div>

  {{range $op := (index $cs "ops")}}
  {{$t := index $op "op_type"}}
  <div style="border:1px solid var(--line);margin-bottom:14px;">
    <div style="display:flex;align-items:center;gap:10px;padding:9px 14px;border-bottom:1px solid var(--line);background:#e9e4da;flex-wrap:wrap;">
      <span class="pillb">{{$t}}</span>
      <span class="mono mut" style="font-size:11px;">op #{{index $op "ordinal"}}</span>
      <span class="mono mut" style="font-size:11px;margin-left:auto;">
        {{with index $op "target_event_id"}}→ {{.}} · {{end}}{{with index $op "resulting_event_id"}}{{.}}{{end}}
      </span>
    </div>
    {{with index $op "payload"}}
    <div style="padding:14px;">
      {{with index . "content"}}<div style="font-size:14px;line-height:1.75;max-width:75ch;margin-bottom:10px;">{{.}}</div>{{end}}
      <div style="display:flex;gap:6px;flex-wrap:wrap;">
        {{with index . "kind"}}<span class="pill">{{.}}</span>{{end}}
        {{with index . "event_type"}}<span class="pill">{{.}}</span>{{end}}
        {{with index . "scope"}}<span class="pill">{{.}}</span>{{end}}
        {{with index . "tags"}}{{range .}}<span class="pill">{{.}}</span>{{end}}{{end}}
      </div>
      <details style="margin-top:10px;"><summary class="mono mut" style="font-size:10.5px;cursor:pointer;letter-spacing:.08em;text-transform:uppercase;">raw payload</summary>
        <pre class="mono mut" style="margin-top:8px;font-size:11px;white-space:pre-wrap;background:#e9e4da;border:1px solid var(--line);padding:10px;">{{prettyJSON .}}</pre>
      </details>
    </div>
    {{end}}
  </div>
  {{end}}
</div>
