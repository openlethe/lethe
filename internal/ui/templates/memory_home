{{template "memory_tabs" .}}

<div class="lx">
  <h1 style="font-size:clamp(30px,4.6vw,52px);line-height:1.04;letter-spacing:-.02em;margin:26px 0 10px;font-weight:700;">
    One memory repository,<br><em style="font-style:normal;border-bottom:5px solid #16130f;">exact at every head.</em>
  </h1>
  <p class="mut" style="max-width:62ch;font-size:15px;line-height:1.6;">
    Accepted memory for <span class="mono" style="background:#e9e4da;border:1px solid var(--line);padding:1px 5px;font-size:12.5px;">{{.project}}</span> —
    reconstructed from immutable changesets on <span class="mono" style="background:#e9e4da;border:1px solid var(--line);padding:1px 5px;font-size:12.5px;">{{.ref}}</span>.
    Agents write on owned refs; only reviewed, signed merges land here.
  </p>
  <div class="rule" style="margin-top:28px;"></div>

  <div class="gridline" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));margin-top:28px;">
    <a class="cellx" href="/ui/memory/memories?project={{.project}}&ref={{.ref | queryEscape}}" style="display:block;padding:22px;background:var(--paper);">
      <div class="kick">01 / tree</div>
      <div style="font-size:20px;font-weight:700;margin:8px 0 4px;display:flex;align-items:baseline;">Memories <span class="mono mut" style="margin-left:auto;font-size:13px;">→</span></div>
      <div class="mut" style="font-size:13px;min-height:40px;">Accepted memory at head, kinds as folders, every record expandable. The files of this repository.</div>
      <div style="display:flex;justify-content:space-between;margin-top:14px;" class="kick"><span>{{index .ctx "total_active"}} active</span><span>head {{printf "%.8s" (index .ctx "head_changeset_id")}}</span></div>
    </a>
    <a class="cellx" href="/ui/memory/changesets?project={{.project}}&ref={{.ref | queryEscape}}" style="display:block;padding:22px;background:var(--paper);">
      <div class="kick">02 / log</div>
      <div style="font-size:20px;font-weight:700;margin:8px 0 4px;display:flex;align-items:baseline;">Changesets <span class="mono mut" style="margin-left:auto;font-size:13px;">→</span></div>
      <div class="mut" style="font-size:13px;min-height:40px;">Every commit of memory: author, message, parents, and each semantic operation as a diff.</div>
      <div style="display:flex;justify-content:space-between;margin-top:14px;" class="kick"><span>{{len .changesets}} reachable</span><span>⟟</span></div>
    </a>
    <a class="cellx" href="/ui/memory/refs?project={{.project}}&ref={{.ref | queryEscape}}" style="display:block;padding:22px;background:var(--paper);">
      <div class="kick">03 / branches</div>
      <div style="font-size:20px;font-weight:700;margin:8px 0 4px;display:flex;align-items:baseline;">Refs <span class="mono mut" style="margin-left:auto;font-size:13px;">→</span></div>
      <div class="mut" style="font-size:13px;min-height:40px;">Protected shared memory, agent-owned branches, session and topic refs, with heads and ownership.</div>
      <div style="display:flex;justify-content:space-between;margin-top:14px;" class="kick"><span>{{len .refs}} refs</span><span>⎇</span></div>
    </a>
    <div class="cellx" style="display:block;padding:22px;background:#e9e4da;">
      <div class="kick">how it lands</div>
      <div class="mut" style="font-size:13px;margin-top:8px;line-height:1.7;">
        changeset on an owned ref → proposal → independent review →
        <span class="mono" style="font-size:11px;color:var(--deep);">memory-git-merge/v2</span> signed envelope →
        protected CAS. Replays rejected; the ledger remembers.
      </div>
    </div>
  </div>
</div>

{{template "memory_status" .}}
