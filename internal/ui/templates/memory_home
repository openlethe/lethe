{{template "memory_tabs" .}}

<div class="gh" style="margin-top:20px;display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:24px;align-items:start;">
  <div>
    {{/* file-browser table */}}
    <div class="card" style="overflow:hidden;">
      <div class="gh-head">
        {{$latest := index .changesets 0}}
        <span style="font-size:14px;">⟟</span>
        <a href="/ui/memory/changesets/{{index $latest "changeset_id"}}?project={{$.project}}" class="gh-mono" style="font-size:12px;font-weight:600;">{{printf "%.10s" (index $latest "changeset_id")}}</a>
        <span style="font-size:12px;color:var(--gh-text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1;">{{index $latest "message"}}</span>
        <span class="gh-muted" style="font-size:12px;flex-shrink:0;">{{since (index $latest "created_at")}} ago</span>
        <span class="gh-pill" style="flex-shrink:0;">{{len .changesets}} changesets</span>
      </div>

      {{if .memories}}
      {{range .memories}}
      {{$kind := index . "kind"}}
      <div class="gh-row">
        <span style="width:18px;text-align:center;flex-shrink:0;">
          {{if eq $kind "decision"}}<span title="decision" style="color:var(--gh-amber);">◆</span>
          {{else if eq $kind "task"}}<span title="task" style="color:var(--gh-link);">☑</span>
          {{else if eq $kind "flag"}}<span title="flag" style="color:var(--gh-red);">⚑</span>
          {{else if eq $kind "fact"}}<span title="fact" style="color:var(--gh-green);">✓</span>
          {{else}}<span title="record" style="color:var(--gh-purple);">≡</span>{{end}}
        </span>
        <span class="gh-mono" style="font-size:12px;color:var(--gh-link);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:260px;flex-shrink:0;" title="{{index . "memory_id"}}">{{index . "memory_id"}}</span>
        <span style="font-size:13px;color:var(--gh-text);overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;flex:1;min-width:0;">{{index . "content"}}</span>
      </div>
      {{end}}
      {{else}}
      <div class="gh-row" style="justify-content:center;padding:32px;">
        <span class="gh-muted" style="font-size:13px;">No accepted memory at <span class="gh-mono">{{.ref}}</span> — nothing has crossed review yet.</span>
      </div>
      {{end}}
    </div>
  </div>

  {{/* About rail */}}
  <div>
    <div style="padding:4px 0 14px;border-bottom:1px solid var(--gh-border);">
      <div style="font-size:13px;font-weight:600;margin-bottom:8px;">About</div>
      <div class="gh-muted" style="font-size:12px;line-height:1.7;">
        Governed shared memory for <span class="gh-mono">{{.project}}</span>. Agents write on owned refs; accepted memory lands here through independently reviewed, signed merges via Charon.
      </div>
      <div style="margin-top:12px;display:grid;gap:7px;font-size:12px;">
        <div><span class="gh-muted">🗂</span> {{index .ctx "total_active"}} memories active</div>
        <div><span class="gh-muted">⟟</span> {{len .changesets}} changesets on <span class="gh-mono">{{.ref}}</span></div>
        <div><span class="gh-muted">⎇</span> {{len .refs}} refs</div>
        <div><span class="gh-muted">🔒</span> merge-auth <span class="gh-mono">memory-git-merge/v2</span></div>
      </div>
    </div>
    <div style="padding-top:14px;">
      <div style="font-size:13px;font-weight:600;margin-bottom:8px;">Tags</div>
      <div style="display:flex;gap:6px;flex-wrap:wrap;">
        {{range .tags}}<span class="gh-pill">{{.}}</span>{{end}}
      </div>
    </div>
  </div>
</div>

<style>@media(max-width:960px){.gh [style*="grid-template-columns:minmax(0,1fr) 280px"]{grid-template-columns:1fr !important}}</style>
