{{template "memory_tabs" .}}

<div class="gh" style="margin-top:20px;">
  <div class="card" style="overflow:hidden;">
    <div class="gh-head">
      <span style="font-size:14px;">⎇</span>
      <span style="font-size:12px;font-weight:600;">{{len .refs}} refs</span>
      <span class="gh-muted" style="font-size:12px;">in</span>
      <span class="gh-mono" style="font-size:12px;">{{.project}}</span>
    </div>

    {{if .refs}}
    {{range $i, $ref := .refs}}
    <div class="gh-row">
      <span style="font-size:13px;color:var(--gh-muted);">⎇</span>
      <div style="min-width:0;flex:1;">
        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
          <a class="gh-mono" style="font-size:13px;" href="/ui/memory/changesets?project={{$.project}}&ref={{index $ref "ref_name" | queryEscape}}">{{index $ref "ref_name"}}</a>
          {{if index $ref "protected"}}<span class="gh-prot">🔒</span>{{end}}
          {{if eq (index $ref "ref_name") $.ref}}<span class="gh-pill" style="color:var(--gh-link);border-color:rgba(9,105,218,.4);">current</span>{{end}}
        </div>
        <div class="gh-muted gh-mono" style="font-size:11px;margin-top:2px;">created by {{index $ref "created_by_principal"}}</div>
      </div>
      <div style="flex-shrink:0;text-align:right;">
        <a class="gh-mono" style="font-size:12px;" href="/ui/memory/changesets/{{index $ref "head_changeset_id"}}?project={{$.project}}">{{printf "%.10s" (index $ref "head_changeset_id")}}</a>
        <div class="gh-muted" style="font-size:11px;margin-top:2px;">updated {{since (index $ref "updated_at")}} ago</div>
      </div>
    </div>
    {{end}}
    {{else}}
    <div class="gh-row" style="justify-content:center;padding:32px;">
      <span class="gh-muted" style="font-size:13px;">No refs for project {{.project}} — initialize with memory_repo_init via Charon.</span>
    </div>
    {{end}}
  </div>
</div>
