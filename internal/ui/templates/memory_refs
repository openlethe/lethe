{{template "memory_tabs" .}}

<div style="margin-bottom:16px;">
  <h1 style="font-size:20px;font-weight:700;color:var(--text);margin-bottom:4px;">Refs</h1>
  <p style="font-size:13px;color:var(--muted);">branches of memory for project <span style="font-family:var(--mono);color:var(--accent);">{{.project}}</span></p>
</div>

{{if .refs}}
<div class="card">
  {{range $i, $ref := .refs}}
  <div style="display:flex;align-items:center;gap:12px;padding:13px 18px;{{if $i}}border-top:1px solid var(--border);{{end}}">
    <span style="font-size:14px;color:var(--accent);">⎇</span>
    <div style="min-width:0;flex:1;">
      <div style="font-family:var(--mono);font-size:13px;color:var(--text);display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
        {{index $ref "ref_name"}}
        {{if index $ref "protected"}}<span style="font-size:10px;font-family:var(--mono);padding:1px 7px;border-radius:9px;background:rgba(57,208,232,.12);color:var(--accent);border:1px solid rgba(57,208,232,.25);">🔒 protected</span>{{end}}
      </div>
      <div style="font-size:11px;color:var(--muted);font-family:var(--mono);margin-top:3px;">created by {{index $ref "created_by_principal"}}</div>
    </div>
    <div style="flex-shrink:0;text-align:right;">
      <a href="/ui/memory/changesets?project={{$.project}}&ref={{index $ref "ref_name" | queryEscape}}" style="font-family:var(--mono);font-size:11px;color:var(--accent);">{{printf "%.12s" (index $ref "head_changeset_id")}}</a>
      <div style="font-size:11px;color:var(--muted);margin-top:3px;">updated {{since (index $ref "updated_at")}} ago</div>
    </div>
  </div>
  {{end}}
</div>
{{else}}
<div class="card">
  <div class="empty-state">
    <div style="font-size:24px;margin-bottom:8px;">⎇</div>
    <div>No refs for project {{.project}}.</div>
    <div style="font-size:12px;color:var(--muted);margin-top:4px;">Initialize the project with memory_repo_init via Charon.</div>
  </div>
</div>
{{end}}
