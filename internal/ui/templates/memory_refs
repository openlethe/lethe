{{template "memory_tabs" .}}

<div class="lx" style="margin-top:22px;">
  <div class="kick">branches / {{.project}}</div>
  <h1 style="font-size:30px;letter-spacing:-.02em;margin:8px 0 4px;font-weight:700;">Refs</h1>
  <p class="mut" style="font-size:13px;">{{len .refs}} branches of memory · shared protected, agent-owned, sessions, topics</p>
  <div class="rule" style="margin-top:20px;"></div>

  {{if .refs}}
  <div>
    {{range $ref := .refs}}
    <div style="display:flex;align-items:baseline;gap:14px;padding:12px 4px;border-bottom:1px solid var(--line);">
      <span class="mono" style="font-size:12px;color:var(--deep);">⎇</span>
      <div style="flex:1;min-width:0;">
        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
          <a href="/ui/memory/changesets?project={{$.project}}&ref={{index $ref "ref_name" | queryEscape}}" class="mono" style="font-size:13px;font-weight:600;color:var(--ink);">{{index $ref "ref_name"}}</a>
          {{if index $ref "protected"}}<span class="prot">🔒 protected</span>{{end}}
          {{if eq (index $ref "ref_name") $.ref}}<span class="pillb">current</span>{{end}}
        </div>
        <div class="mono mut" style="font-size:11px;margin-top:2px;">created by {{index $ref "created_by_principal"}}</div>
      </div>
      <div style="flex-shrink:0;text-align:right;">
        <a href="/ui/memory/changesets/{{index $ref "head_changeset_id"}}?project={{$.project}}" class="mono" style="font-size:12px;color:var(--deep);">{{printf "%.10s" (index $ref "head_changeset_id")}}</a>
        <div class="mono mut" style="font-size:10.5px;margin-top:2px;">updated {{since (index $ref "updated_at")}}</div>
      </div>
    </div>
    {{end}}
  </div>
  {{else}}
  <div class="cellx" style="margin-top:26px;padding:34px;text-align:center;">
    <div class="mut" style="font-size:13px;">No refs for project {{.project}} — initialize with memory_repo_init via Charon.</div>
  </div>
  {{end}}
</div>

{{template "memory_status" .}}
